# Canonical site URL (no trailing slash). Set in Vercel project settings.
NEXT_PUBLIC_SITE_URL=https://toolnow-free.vercel.app

# Google Analytics 4 measurement ID (leave unset to disable analytics).
NEXT_PUBLIC_GA_ID=

# Google AdSense publisher ID, e.g. ca-pub-XXXXXXXXXXXXXXXX
# (leave unset until AdSense approval — ad slots render nothing without it).
NEXT_PUBLIC_ADSENSE_CLIENT=

# Web3Forms access key for the contact form (free at web3forms.com).
NEXT_PUBLIC_WEB3FORMS_KEY=
